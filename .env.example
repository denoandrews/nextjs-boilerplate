# Server-side credential. Never prefix this variable with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Use VECTOR_STORE_ID for the current single-store prototype.
VECTOR_STORE_ID=

# Future-ready alternative: comma-separated municipal, county, state, and trusted-source stores.
# VECTOR_STORE_IDS=vs_municipal,vs_county,vs_state

MUNICIPALITY_NAME=City of Strawberry Point, Iowa
MUNICIPALITY_SLUG=strawberry-point-ia

# Optional. Legacy model for a municipality without newspaper search.
# A value that cannot reason, such as gpt-4.1-mini, is kept and reasoning is omitted.
# OPENAI_MODEL=gpt-4.1-mini
# Optional. Overrides the chat model for every municipality. Oak Park defaults to gpt-5.4-mini.
# MUNIGPT_CHAT_MODEL=gpt-5.4-mini
# Optional. none, low, medium, high, or xhigh. Defaults to medium. Ignored for a model that cannot reason.
# MUNIGPT_REASONING_EFFORT=medium
# Optional. Includes reasoning tokens. Defaults to 4000 for medium reasoning on gpt-5, otherwise 1600 for gpt-5 and 800 for gpt-4.1. Capped at 8000.
# OPENAI_MAX_OUTPUT_TOKENS=4000
# RATE_LIMIT_SALT=replace-with-a-long-random-value
# Update these only when OpenAI pricing changes. Values are USD per unit shown.
# OPENAI_INPUT_COST_PER_MILLION=0.4
# OPENAI_CACHED_INPUT_COST_PER_MILLION=0.1
# OPENAI_OUTPUT_COST_PER_MILLION=1.6
# OPENAI_FILE_SEARCH_COST_PER_THOUSAND=2.5

# Supabase authentication, tenant data, private document storage, and analytics.
# Admin routes stay unavailable and public chat continues without logging when omitted.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical deployment origin used when generating embed code outside a proxied request.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Space-separated CSP frame ancestors. Include each approved municipal website origin.
# EMBED_FRAME_ANCESTORS='self' https://www.example.gov
